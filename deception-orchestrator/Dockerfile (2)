# Deception Orchestrator - Go Service
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev

# Copy go modules
COPY go.mod ./

# Copy source
COPY internal/ ./internal/
COPY cmd/ ./cmd/

# Download dependencies
RUN go mod tidy

# Build
RUN CGO_ENABLED=1 GOOS=linux go build -o /deception-orchestrator ./cmd/main.go

# Runtime stage
FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates curl

# Copy binary
COPY --from=builder /deception-orchestrator /app/deception-orchestrator

# Create directories
RUN mkdir -p /data /models

# Expose port (8001 for API, 8080 for Swagger UI)
EXPOSE 8001 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Default command
CMD ["/app/deception-orchestrator"]