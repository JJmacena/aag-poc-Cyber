# Initialization Service - Runs data generation, model training, and validation
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy all project files
COPY . /app/

# Install Python packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn==0.27.0 \
    pydantic==2.5.3 \
    pydantic-settings==2.1.0 \
    httpx==0.26.0 \
    river==0.21.0 \
    numpy==1.26.2 \
    torch==2.1.2 \
    pyarrow==14.0.2 \
    pandas==2.1.4 \
    scikit-learn==1.3.2 \
    clickhouse-driver==0.2.6 \
    kafka-python==2.0.2 \
    redis==5.0.1 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.0 \
    pyyaml==6.0.1 \
    sentence-transformers==3.0.0 \
    faiss-cpu==1.8.0 \
    scipy==1.11.4 \
    matplotlib==3.8.2 \
    seaborn==0.13.0

# Install local packages in development mode
RUN pip install --no-cache-dir -e ./behavioral-engine -e ./agent-profiler -e ./datasets -e ./validation

# Make init script executable
RUN chmod +x /app/init.sh

# Create directories
RUN mkdir -p /data /models /validation_results

# Default command runs init script
ENTRYPOINT ["/bin/bash", "/app/init.sh"]